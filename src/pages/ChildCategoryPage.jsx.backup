        { name: "Throttle Controller", desc: "9-mode throttle response controller" },
        { name: "OBD2 Scanner Pro", desc: "Professional diagnostic tool with live data" },
    const childItem = categoryData?.items.find(item => item.id === childId);

    if(!childItem) {
        return <div className="p-8 text-center text-white">Category not found</div>;
    }

    // Get specific images and descriptions for this category
    const categoryImages = productImages[childId] || productImages.default;
    const categoryDescs = productDescriptions[childId] || productDescriptions.wheels;

    // Mock products
    const initialProducts = useMemo(() => Array(6).fill(null).map((_, i) => ({
        id: i,
        name: categoryDescs[i]?.name || `${childItem.name} Pro Kit ${i + 1}`,
        description: categoryDescs[i]?.desc || `Premium ${childItem.name.toLowerCase()} upgrade package`,
        price: 299 + (i * 50),
        rating: 4.5 + (i * 0.1),
        image: categoryImages[i % categoryImages.length]
    })), [childItem, categoryImages, categoryDescs]);

    const [viewMode, setViewMode] = useState('grid');
    const [sortOption, setSortOption] = useState('featured');
    const [isSortOpen, setIsSortOpen] = useState(false);

    // Sort items
    const sortedProducts = useMemo(() => {
        let sorted = [...initialProducts];
        if (sortOption === 'name-asc') {
            sorted.sort((a, b) => a.name.localeCompare(b.name));
        } else if (sortOption === 'name-desc') {
            sorted.sort((a, b) => b.name.localeCompare(a.name));
        } else if (sortOption === 'price-asc') {
            sorted.sort((a, b) => a.price - b.price);
        } else if (sortOption === 'price-desc') {
            sorted.sort((a, b) => b.price - a.price);
        }
        return sorted;
    }, [initialProducts, sortOption]);

    const sortOptions = [
        { id: 'featured', label: 'Featured' },
        { id: 'name-asc', label: 'Name (A-Z)' },
        { id: 'name-desc', label: 'Name (Z-A)' },
        { id: 'price-asc', label: 'Price (Low-High)' },
        { id: 'price-desc', label: 'Price (High-Low)' }
    ];

    const container = {
        hidden: { opacity: 0 },
        show: {
            opacity: 1,
            transition: { staggerChildren: 0.1 }
        }
    };

    const itemAnim = {
        hidden: { opacity: 0, y: 20 },
        show: { opacity: 1, y: 0 }
    };

    return(
        <div className = "min-h-screen bg-black text-white pt-24 pb-12" >
            <div className="container mx-auto px-6">
                {/* Header Section */}
                <div className="flex items-center gap-4 mb-8">
                    <div className="p-3 bg-zinc-900 rounded-xl">
                        <childItem.icon size={32} className="text-white" />
                    </div>
                    <div>
                        <h1 className="text-4xl font-bold">{childItem.name}</h1>
                        <p className="text-gray-400 mt-1">{childItem.description}</p>
                    </div>
                </div>

                {/* Action Bar */}
                <div className="category-actions-bar mb-8">
                    <div className="flex items-center gap-6">
                        <button className="action-btn">
                            <span className="font-medium">Filter</span>
                        </button>

                        {/* Sort Dropdown */}
                        <div className="relative">
                            <button
                                className="action-btn"
                                onClick={() => setIsSortOpen(!isSortOpen)}
                                onBlur={() => setTimeout(() => setIsSortOpen(false), 200)}
                            >
                                <span className="font-medium">Sort By: {sortOptions.find(o => o.id === sortOption)?.label}</span>
                                <ChevronRight size={16} className={`transition-transform ${isSortOpen ? 'rotate-90' : ''}`} />
                            </button>

                            {isSortOpen && (
                                <div className="sort-dropdown">
                                    {sortOptions.map(option => (
                                        <button
                                            key={option.id}
                                            className={`sort-option ${sortOption === option.id ? 'active' : ''}`}
                                            onClick={() => {
                                                setSortOption(option.id);
                                                setIsSortOpen(false);
                                            }}
                                        >
                                            {option.label}
                                        </button>
                                    ))}
                                </div>
                            )}
                        </div>
                    </div>

                    <div className="view-toggle">
                        <button
                            onClick={() => setViewMode('grid')}
                            className={`view-toggle-btn ${viewMode === 'grid' ? 'active' : ''}`}
                            aria-label="Grid view"
                        >
                            <Grid3x3 size={20} />
                        </button>
                        <button
                            onClick={() => setViewMode('list')}
                            className={`view-toggle-btn ${viewMode === 'list' ? 'active' : ''}`}
                            aria-label="List view"
                        >
                            <List size={20} />
                        </button>
                    </div>
                </div>

                {/* Products Grid */}
                <motion.div
                    variants={container}
                    initial="hidden"
                    animate="show"
                    className={viewMode === 'grid'
                        ? "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"
                        : "flex flex-col gap-4"
                    }
                >
                    {sortedProducts.map((product) => (
                        <motion.div key={product.id} variants={itemAnim}>
                            <ProductCard product={product} viewMode={viewMode} />
                        </motion.div>
                    ))}
                </motion.div>
            </div>
        </div >
    );
};

export default ChildCategoryPage;
