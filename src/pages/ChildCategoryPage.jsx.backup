        { name: "GPS Tracker", desc: "Real-time GPS tracking with geofencing alerts" },
        { name: "Parking Mode Dashcam", desc: "Motion-activated recording when parked" },
        { name: "Mirror Dashcam", desc: "Rearview mirror with integrated front/rear cameras" },
        { name: "Security Alarm System", desc: "2-way remote start with shock sensor" },
        { name: "Complete Security Package", desc: "Dashcam, GPS tracker, and alarm system bundle" }
